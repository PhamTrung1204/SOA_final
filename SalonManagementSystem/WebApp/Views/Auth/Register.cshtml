@model SalonManagementSystem.Shared.Models.RegisterRequest

@{
    ViewData["Title"] = "Register";
}

<div class="auth-container">
    <h2>Register</h2>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    <form asp-action="Register" method="post">
        <div class="form-group">
            <label asp-for="Name"><i class="fas fa-user"></i> Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="form-group">
            <label asp-for="Email"><i class="fas fa-envelope"></i> Email</label>
            <input asp-for="Email" class="form-control" required />
        </div>
        <div class="form-group">
            <label asp-for="Password"><i class="fas fa-lock"></i> Password</label>
            <input asp-for="Password" type="password" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Register</button>
    </form>
    <p class="text-center mt-3">Already have an account? <a asp-action="Login">Login</a></p>
</div>