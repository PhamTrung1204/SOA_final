@model SalonManagementSystem.Shared.Models.LoginRequest

@{
    ViewData["Title"] = "Login";
}

<div class="auth-container">
    <h2>Login</h2>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    <form asp-action="Login" method="post">
        <div class="form-group">
            <label asp-for="Email"><i class="fas fa-envelope"></i> Email</label>
            <input asp-for="Email" class="form-control" required />
        </div>
        <div class="form-group">
            <label asp-for="Password"><i class="fas fa-lock"></i> Password</label>
            <input asp-for="Password" type="password" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Login</button>
    </form>
    <p class="text-center mt-3">Don't have an account? <a asp-action="Register">Register</a></p>
</div>