@model List<SalonManagementSystem.Shared.Models.Service>
@{
    ViewData["Title"] = "Home";
}

<!-- Banner Section -->
<div id="bannerCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop" class="d-block w-100" alt="Salon Banner 1" style="height: 500px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block">
                <h1 class="display-4 text-white">Welcome to Salon Elegance</h1>
                <p class="lead text-white">Experience luxury hair and beauty services.</p>
                <a href="/BookAppointment" class="btn btn-primary btn-lg">Book Now</a>
            </div>
        </div>
        <div class="carousel-item">
            <img src="https://images.unsplash.com/photo-1519419691348-3b3435317d77?q=80&w=2070&auto=format&fit=crop" class="d-block w-100" alt="Salon Banner 2" style="height: 500px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block">
                <h1 class="display-4 text-white">Special Offer This Month!</h1>
                <p class="lead text-white">Get 20% off on all hair treatments.</p>
                <a href="/Services" class="btn btn-primary btn-lg">Explore Services</a>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<!-- Services Section -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center mb-5">Our Services</h2>
        <div class="row">
            @if (Model != null && Model.Any())
            {
                @foreach (var service in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop" class="card-img-top" alt="@service.Name" style="height: 200px; object-fit: cover;">
                            <div class="card-body">
                                <h5 class="card-title">@service.Name</h5>
                                <p class="card-text">@service.Description</p>
                                <p class="card-text"><strong>Price:</strong> $@service.Price</p>
                                <a href="/BookAppointment?serviceId=@service.ServiceId" class="btn btn-primary">Book Now</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p class="text-center">No services available at the moment.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- About Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h2>About Salon Elegance</h2>
                <p>We are a premier salon offering a wide range of hair and beauty services. Our team of professionals is dedicated to making you look and feel your best. Visit us today and experience the difference!</p>
                <a href="/About" class="btn btn-outline-primary">Learn More</a>
            </div>
            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=2070&auto=format&fit=crop" class="img-fluid rounded" alt="About Salon" style="height: 300px; object-fit: cover;">
            </div>
        </div>
    </div>
</section>

<!-- Promotion Section -->
<section class="py-5">
    <div class="container">
        <h2 class="text-center mb-5">Special Promotions</h2>
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <h4 class="card-title">20% Off Haircuts</h4>
                        <p class="card-text">Book a haircut this month and enjoy a 20% discount!</p>
                        <a href="/BookAppointment" class="btn btn-success">Claim Offer</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body text-center">
                        <h4 class="card-title">Free Hair Treatment</h4>
                        <p class="card-text">Get a free hair treatment with any coloring service.</p>
                        <a href="/BookAppointment" class="btn btn-success">Claim Offer</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Section -->
<section class="py-5 bg-primary text-white text-center">
    <div class="container">
        <h2>Ready to Transform Your Look?</h2>
        <p class="lead">Book your appointment today and let our experts take care of you.</p>
        <a href="/BookAppointment" class="btn btn-light btn-lg">Book Appointment</a>
    </div>
</section>