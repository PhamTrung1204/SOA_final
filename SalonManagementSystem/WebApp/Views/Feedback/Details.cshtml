@model SalonManagementSystem.Shared.Models.Feedback

@{
    ViewData["Title"] = "Feedback Details";
}

<h2>Feedback Details</h2>
<div>
    <dl class="row">
        <dt class="col-sm-2">Appointment ID</dt>
        <dd class="col-sm-10">@Model.AppointmentId</dd>
        <dt class="col-sm-2">Rating</dt>
        <dd class="col-sm-10">@Model.Rating</dd>
        <dt class="col-sm-2">Comment</dt>
        <dd class="col-sm-10">@Model.Comment</dd>
        <dt class="col-sm-2">Submitted At</dt>
        <dd class="col-sm-10">@Model.CreatedAt</dd>
    </dl>
</div>
<div>
    <a asp-action="Index">Back to List</a>
</div>