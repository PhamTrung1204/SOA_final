@model SalonManagementSystem.Shared.Models.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "Process Payment";
}

<h2>Process Payment</h2>

<form asp-action="Process" method="post">
    <input type="hidden" asp-for="AppointmentId" />
    <div class="form-group">
        <label asp-for="Payment.AppointmentId"></label>
        <input asp-for="Payment.AppointmentId" class="form-control" value="@Model.AppointmentId" readonly />
    </div>
    <div class="form-group">
        <label asp-for="Payment.Amount"></label>
        <input asp-for="Payment.Amount" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Process</button>
</form>