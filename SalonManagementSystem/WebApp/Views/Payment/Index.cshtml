@model IEnumerable<SalonManagementSystem.Shared.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<h1>Payments</h1>
<table class="table">
    <thead>
        <tr>
            <th>Appointment ID</th>
            <th>Amount</th>
            <th>Processed At</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AppointmentId</td>
                <td>@item.Amount</td>
                <td>@item.CreatedAt</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.PaymentId">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>