@model IEnumerable<SalonManagementSystem.Shared.Models.Service>

@{
    ViewData["Title"] = "Services";
}

<h1>Services</h1>
<p><a asp-action="Create" class="btn btn-primary">Create New</a></p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Duration</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                    <td>@item.Duration</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.ServiceId">Details</a> |
                        <a asp-action="Edit" asp-route-id="@item.ServiceId">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@item.ServiceId">Delete</a>
                    </td>
                </tr>
        }
    </tbody>
</table>