@model SalonManagementSystem.Shared.Models.Service
@{
    ViewData["Title"] = "Chỉnh sửa Dịch vụ";
}

<div class="container py-4">
    <h2 class="fw-bold text-warning mb-4">✏️ Chỉnh sửa Dịch vụ</h2>
    <form asp-action="Edit" method="post" class="card p-4 shadow-sm bg-light rounded-4">
        <input type="hidden" asp-for="ServiceId" />

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Tên dịch vụ</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Giá (VNĐ)</label>
                <input asp-for="Price" type="number" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Thời gian thực hiện (phút)</label>
            <input asp-for="Duration" type="number" class="form-control" />
        </div>

        <div class="text-end">
            <a href="/Service" class="btn btn-secondary me-2">Huỷ</a>
            <button type="submit" class="btn btn-warning text-white">Cập nhật</button>
        </div>
    </form>
</div>
