@model SalonManagementSystem.Shared.Models.ViewModels.BookingViewModel

@{
    ViewData["Title"] = "Create Booking";
}

<h2>Create Booking</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Appointment.CustomerId"></label>
        <input asp-for="Appointment.CustomerId" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Appointment.StaffId"></label>
        <select asp-for="Appointment.StaffId" asp-items="@(new SelectList(Model.StaffList, "StaffId", "Name"))" class="form-control"></select>
    </div>
    <div class="form-group">
        <label asp-for="Appointment.ServiceId"></label>
        <select asp-for="Appointment.ServiceId" asp-items="@(new SelectList(Model.ServiceList, "ServiceId", "Name"))" class="form-control"></select>
    </div>
    <div class="form-group">
        <label asp-for="Appointment.AppointmentDate"></label>
        <input asp-for="Appointment.AppointmentDate" type="datetime-local" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>