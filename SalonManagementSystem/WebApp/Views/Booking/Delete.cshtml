@model SalonManagementSystem.Shared.Models.Appointment

@{
    ViewData["Title"] = "Delete Booking";
}

<h2>Delete Booking</h2>
<h3>Are you sure you want to delete this?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Customer ID</dt>
        <dd class="col-sm-10">@Model.CustomerId</dd>
        <dt class="col-sm-2">Staff ID</dt>
        <dd class="col-sm-10">@Model.StaffId</dd>
        <dt class="col-sm-2">Service ID</dt>
        <dd class="col-sm-10">@Model.ServiceId</dd>
        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Model.AppointmentDate</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>
    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="AppointmentId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>