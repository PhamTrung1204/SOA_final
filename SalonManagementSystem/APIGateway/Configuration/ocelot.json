{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/customers",
      "DownstreamScheme": "http",
      "ServiceName": "customerservice",
      "UseServiceDiscovery": true,
      "UpstreamPathTemplate": "/api/customers",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/api/staff",
      "DownstreamScheme": "http",
      "ServiceName": "staffservice",
      "UseServiceDiscovery": true,
      "UpstreamPathTemplate": "/api/staff",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/api/services",
      "UpstreamPathTemplate": "/api/services",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "ServiceName": "serviceservice",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "UseServiceDiscovery": true,
      "DownstreamScheme": "http"
    },
    {
      "DownstreamPathTemplate": "/api/appointments",
      "DownstreamScheme": "http",
      "ServiceName": "appointmentservice",
      "UseServiceDiscovery": true,
      "UpstreamPathTemplate": "/api/appointments",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/api/payments",
      "DownstreamScheme": "http",
      "ServiceName": "paymentservice",
      "UseServiceDiscovery": true,
      "UpstreamPathTemplate": "/api/payments",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/api/feedback",
      "DownstreamScheme": "http",
      "ServiceName": "feedbackservice",
      "UseServiceDiscovery": true,
      "UpstreamPathTemplate": "/api/feedback",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000",
    "ServiceDiscoveryProvider": {
      "Host": "consul",
      "Port": 8500,
      "Type": "Consul",
      "PollingInterval": 1000
    },
    "Cors": {
      "Origins": [ "http://localhost:5007" ],
      "Methods": [ "GET", "POST", "PUT", "DELETE" ],
      "Headers": [ "*" ]
    }
  }
}
