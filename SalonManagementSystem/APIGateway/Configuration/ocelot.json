{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/customer/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "customerservice",
      "UseServiceDiscovery": true,
      "UpstreamPathTemplate": "/api/customer/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ]
    },
    {
      "DownstreamPathTemplate": "/api/staff/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "staffservice",
      "UseServiceDiscovery": true,
      "UpstreamPathTemplate": "/api/staff/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ]
    },
    {
      "DownstreamPathTemplate": "/api/services/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "serviceservice",
      "UseServiceDiscovery": true,
      "UpstreamPathTemplate": "/api/services/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ]
    },
    {
      "DownstreamPathTemplate": "/api/appointment/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "appointmentservice",
      "UseServiceDiscovery": true,
      "UpstreamPathTemplate": "/api/appointment/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ]
    },
    {
      "DownstreamPathTemplate": "/api/payment/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "paymentservice",
      "UseServiceDiscovery": true,
      "UpstreamPathTemplate": "/api/payment/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ]
    },
    {
      "DownstreamPathTemplate": "/api/feedback/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "feedbackservice",
      "UseServiceDiscovery": true,
      "UpstreamPathTemplate": "/api/feedback/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ]
    },
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "customerservice",
      "UseServiceDiscovery": true,
      "UpstreamPathTemplate": "/api/auth/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://apigateway:8080",
    "ServiceDiscoveryProvider": {
      "Host": "consul",
      "Port": 8500,
      "Type": "Consul",
      "PollingInterval": 1000
    }
  }
}